# ==========================================
# EMC SOLDAS - Arquivo de Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados locais.
# NUNCA versione o arquivo .env real no Git!
# ==========================================

# Chaves Criptográficas
SECRET_KEY=django-insecure-emc-soldas-dev-key-industrial-integrity-2026-secure-token-998877
ENCRYPTION_KEY=emc_soldas_aes256_master_key_local_dev_only_32_bytes_len=

# Modo de Depuração (True para Dev local, False para Produção)
DEBUG=True

# Hosts Permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de Dados MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=emc_soldas
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# E-mail / SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.exemplo.com.br
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificacoes@emcsoldas.com.br
EMAIL_HOST_PASSWORD=sua-senha-smtp-aqui

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
