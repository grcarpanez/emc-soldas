# ==========================================
# .gitignore - Sistema EMC Soldas
# ==========================================

# Ambientes Virtuais Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Compilados e Caches Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testes e Cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Arquivos de Configuração Real e Segredos
.env
.env.local
.env.*.local
*.env
local_settings.py
settings_local.py
*.pem
*.key
*.cert
*.pfx
*.p12

# Logs Físicos (Mantém a pasta via .gitkeep)
backend/logs/*
!backend/logs/.gitkeep
*.log

# Mídia e Uploads Protegidos (Mantém a pasta via .gitkeep)
backend/media/*
!backend/media/.gitkeep

# Arquivos Estáticos Coletados em Produção
backend/staticfiles/

# Banco de Dados e Dumps Locais
*.sqlite3
*.sqlite3-journal
*.sql
*.dump
*.backup

# Extratos bancários reais e temporários
*.ofx
*.qfx

# IDEs e Editores de Código
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
